rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ── Auth helpers (role is read from Firestore users/{uid}) ────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function userDocPath() {
      return /databases/(default)/documents/users/$(uid());
    }

    function userDocExists() {
      return isSignedIn() && firestore.exists(userDocPath());
    }

    function userData() {
      return firestore.get(userDocPath()).data;
    }

    function isActiveUser() {
      return userDocExists() && userData().status == 'active';
    }

    function isAdmin() {
      return userDocExists() && userData().role == 'admin';
    }

    function isCompany() {
      return userDocExists() && userData().role == 'company';
    }

    function isStudent() {
      return userDocExists() && userData().role == 'student';
    }

    function isOwner(ownerId) {
      return isSignedIn() && uid() == ownerId;
    }

    function companyHasMatchAccess(studentId) {
      return isCompany()
        && isActiveUser()
        && firestore.exists(/databases/(default)/documents/match_access/$(uid() + '_' + studentId));
    }

    function isValidUpload() {
      return request.resource != null
        && request.resource.size < 15 * 1024 * 1024;
    }

    function isValidVideoUpload() {
      return request.resource != null
        && request.resource.size < 100 * 1024 * 1024;
    }

    function isDocumentOrImageUpload() {
      return request.resource.contentType.matches(
        'application/pdf|application/msword|application/vnd\\.openxmlformats-officedocument\\.wordprocessingml\\.document|image/jpeg|image/jpg|image/png|image/webp'
      );
    }

    function isImageUpload() {
      return request.resource.contentType.matches('image/jpeg|image/jpg|image/png|image/webp');
    }

    function isVideoUpload() {
      return request.resource.contentType.matches('video/mp4|video/webm|video/quicktime');
    }

    function isAudioUpload() {
      return request.resource.contentType.matches('audio/mpeg|audio/mp3|audio/wav|audio/x-wav|audio/aac|audio/webm');
    }

    function isDocumentImageOrVideoUpload() {
      return isDocumentOrImageUpload() || isVideoUpload();
    }

    // ── User profile photos (account settings) ────────────────────────────

    match /users/{userId}/{allPaths=**} {
      allow write: if isValidUpload() && isImageUpload()
        && (isAdmin() || (isOwner(userId) && isActiveUser()));
      allow read: if true;
    }

    // ── Student CVs (canonical + current app paths) ───────────────────────

    match /cvs/{studentId}/{allPaths=**} {
      allow write: if isValidUpload() && isDocumentOrImageUpload()
        && (isAdmin() || (isOwner(studentId) && isStudent() && isActiveUser()));
      allow read: if isAdmin() || isOwner(studentId) || companyHasMatchAccess(studentId);
    }

    match /students/{studentId}/cv/{allPaths=**} {
      allow write: if isValidUpload() && isDocumentOrImageUpload()
        && (isAdmin() || (isOwner(studentId) && isStudent() && isActiveUser()));
      allow read: if isAdmin() || isOwner(studentId) || companyHasMatchAccess(studentId);
    }

    // Evidence documents (PDF / Word / image).
    match /students/{studentId}/document/{allPaths=**} {
      allow write: if isValidUpload() && isDocumentOrImageUpload()
        && (isAdmin() || (isOwner(studentId) && isStudent() && isActiveUser()));
      allow read: if isAdmin() || isOwner(studentId) || companyHasMatchAccess(studentId);
    }

    // Shadow sprint deliverables (docs / images / video).
    match /students/{studentId}/sprint/{allPaths=**} {
      allow write: if (
          (isValidUpload() && isDocumentOrImageUpload())
          || (isValidVideoUpload() && isVideoUpload())
        )
        && (isAdmin() || (isOwner(studentId) && isStudent() && isActiveUser()));
      allow read: if isAdmin() || isOwner(studentId) || companyHasMatchAccess(studentId);
    }

    match /students/{studentId}/video/{allPaths=**} {
      allow write: if isValidVideoUpload() && isVideoUpload()
        && (isAdmin() || (isOwner(studentId) && isStudent() && isActiveUser()));
      allow read: if isAdmin() || isOwner(studentId) || companyHasMatchAccess(studentId);
    }

    // ── Student photos ────────────────────────────────────────────────────

    match /student-photos/{studentId}/{allPaths=**} {
      allow write: if isValidUpload() && isImageUpload()
        && (isAdmin() || (isOwner(studentId) && isStudent() && isActiveUser()));
      allow read: if isAdmin() || isOwner(studentId) || companyHasMatchAccess(studentId);
    }

    match /students/{studentId}/photo/{allPaths=**} {
      allow write: if isValidUpload() && isImageUpload()
        && (isAdmin() || (isOwner(studentId) && isStudent() && isActiveUser()));
      allow read: if isAdmin() || isOwner(studentId) || companyHasMatchAccess(studentId);
    }

    // ── Company logos ─────────────────────────────────────────────────────

    match /company-logos/{companyId}/{allPaths=**} {
      allow write: if isValidUpload() && isImageUpload()
        && (isAdmin() || (isOwner(companyId) && isCompany() && isActiveUser()));
      allow read: if true;
    }

    match /companies/{companyId}/logo/{allPaths=**} {
      allow write: if isValidUpload() && isImageUpload()
        && (isAdmin() || (isOwner(companyId) && isCompany() && isActiveUser()));
      allow read: if true;
    }

    // Company requirement documents (private to owner + admin).
    match /companies/{companyId}/requirements/{allPaths=**} {
      allow write: if isValidUpload() && isDocumentOrImageUpload()
        && (isAdmin() || (isOwner(companyId) && isCompany() && isActiveUser()));
      allow read: if isAdmin() || (isOwner(companyId) && isCompany() && isActiveUser());
    }

    match /companies/{companyId}/jd/{allPaths=**} {
      allow write: if isValidUpload() && isDocumentOrImageUpload()
        && (isAdmin() || (isOwner(companyId) && isCompany() && isActiveUser()));
      allow read: if isAdmin() || (isOwner(companyId) && isCompany() && isActiveUser());
    }

    match /companies/{companyId}/sprint_deliverable/{allPaths=**} {
      allow write: if (
          (isValidUpload() && isDocumentOrImageUpload())
          || (isValidVideoUpload() && isVideoUpload())
        )
        && (isAdmin() || (isOwner(companyId) && isCompany() && isActiveUser()));
      allow read: if isAdmin() || (isOwner(companyId) && isCompany() && isActiveUser());
    }

    // ── Purchase-gated store content (stream via /api/student/store/download) ─

    match /content/{contentItemId}/{allPaths=**} {
      allow write: if (
          (isValidUpload() && (isDocumentOrImageUpload() || isAudioUpload()))
          || (isValidVideoUpload() && (isVideoUpload() || isAudioUpload()))
        ) && isAdmin();
      allow read: if false;
    }

    // ── Public CMS media ──────────────────────────────────────────────────

    match /journal-covers/{allPaths=**} {
      allow write: if isValidUpload() && isImageUpload() && isAdmin();
      allow read: if true;
    }

    match /team-photos/{allPaths=**} {
      allow write: if isValidUpload() && isImageUpload() && isAdmin();
      allow read: if true;
    }

    match /testimonials/{allPaths=**} {
      allow write: if (
          (isValidUpload() && isDocumentOrImageUpload())
          || (isValidVideoUpload() && isVideoUpload())
        ) && isAdmin();
      allow read: if true;
    }

    match /talent-stories/{allPaths=**} {
      allow write: if isValidUpload() && isImageUpload() && isAdmin();
      allow read: if true;
    }

    match /admin/{allPaths=**} {
      allow write: if (
          (isValidUpload() && (isDocumentOrImageUpload() || isAudioUpload()))
          || (isValidVideoUpload() && (isVideoUpload() || isAudioUpload()))
        ) && isAdmin();
      allow read: if true;
    }

    // ── Job descriptions / inbound form uploads ───────────────────────────

    match /job-descriptions/{allPaths=**} {
      allow write: if isValidUpload() && isDocumentOrImageUpload()
        && (isAdmin() || (isCompany() && isActiveUser()));
      allow read: if isAdmin() || (isCompany() && isActiveUser());
    }

    // Anonymous inbound uploads (write-only; served/processed via Admin SDK APIs).
    match /careers/applications/{jobId}/{allPaths=**} {
      allow write: if isValidUpload() && isDocumentOrImageUpload();
      allow read: if isAdmin();
    }

    match /requests/sourcing/{allPaths=**} {
      allow write: if isValidUpload() && isDocumentOrImageUpload();
      allow read: if isAdmin();
    }

    match /roles/interest/{roleId}/{allPaths=**} {
      allow write: if isValidUpload() && isDocumentOrImageUpload();
      allow read: if isAdmin();
    }

    // ── Default deny ──────────────────────────────────────────────────────

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
